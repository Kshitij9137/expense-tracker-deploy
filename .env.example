# Copy to .env (never commit .env) and fill in real values.
APP_ENV=staging                 # development | staging | production
API_KEY=change-me-to-a-long-random-string   # at least 16 characters; generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
DB_PATH=/data/expenses.db
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
WEB_CONCURRENCY=2
PORT=8000
